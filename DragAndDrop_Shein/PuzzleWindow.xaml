<Window x:Class="DragAndDrop_Shein.PuzzleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Пазл — Drag &amp; Drop" Height="600" Width="880"
        MinHeight="600" MinWidth="880">
    <Canvas x:Name="mainCanvas" Background="#ECEFF1">
        <Rectangle Canvas.Left="420" Canvas.Top="0" Width="2" Height="600"
                   Fill="#B0BEC5"/>
        <TextBlock Canvas.Left="30" Canvas.Top="15"
                   FontSize="14" Foreground="#546E7A" FontWeight="Bold"
                   Text="Фрагменты"/>
        <TextBlock Canvas.Left="570" Canvas.Top="15"
                   FontSize="14" Foreground="#546E7A" FontWeight="Bold"
                   Text="Собери пазл"/>
        <TextBlock x:Name="statusText"
                   Canvas.Left="0" Canvas.Top="548"
                   Width="880" TextAlignment="Center"
                   FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
        <Button x:Name="btnRestart" Content="Заново"
                Canvas.Left="20" Canvas.Top="540"
                Width="90" Height="32"
                Click="BtnRestart_Click"/>
    </Canvas>
</Window>
